<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1040</width><height>680</height></rect></property>
  <property name="minimumSize"><size><width>900</width><height>600</height></size></property>
  <property name="windowTitle"><string>Cyber Launcher</string></property>
  <property name="styleSheet"><string notr="true">
QWidget { color: #f2f2f2; font-size: 14px; }
QWidget#central { background: transparent; }
QFrame#sidebar { background-color: rgba(0, 0, 0, 150); border-right: 1px solid rgba(255, 255, 255, 25); }
QToolButton { background: transparent; border: none; border-radius: 12px; color: #a0a0a0; font-size: 11px; padding: 8px 2px; }
QToolButton:hover { background-color: rgba(255, 255, 255, 18); color: #ffffff; }
QToolButton:checked { background-color: rgba(255, 255, 255, 34); color: #ffffff; }
QFrame[class="card"] { background-color: rgba(8, 8, 8, 175); border: 1px solid rgba(255, 255, 255, 30); border-radius: 16px; }
QLabel { background: transparent; }
QLabel[class="caption"] { color: #9a9a9a; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
QLabel[class="muted"] { color: #b0b0b0; }
QLabel[class="pageTitle"] { font-size: 30px; font-weight: 700; }
QLabel#heroTitle { font-size: 42px; font-weight: 700; }
QLabel[class="chip"] { background-color: rgba(255, 255, 255, 26); border-radius: 12px; padding: 5px 12px; color: #e8e8e8; font-size: 12px; }
QLineEdit, QComboBox, QSpinBox { background-color: #101010; border: 1px solid #333333; border-radius: 10px; padding: 8px 10px; selection-background-color: #ffffff; selection-color: #000000; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid #ffffff; }
QComboBox QAbstractItemView { background-color: #101010; border: 1px solid #333333; selection-background-color: #2a2a2a; outline: none; }
QPushButton { background-color: #1c1c1c; border: 1px solid #333333; border-radius: 10px; padding: 9px 16px; }
QPushButton:hover { background-color: #2a2a2a; }
QPushButton#playButton { background-color: #22d65f; color: #03150a; border: none; border-radius: 30px; font-size: 18px; font-weight: 800; padding: 0 36px; }
QPushButton#playButton:hover { background-color: #3ee878; }
QPushButton#playButton:disabled { background-color: #1b3a27; color: #6d8f7a; }
QPushButton#refreshButton { background-color: #f59e0b; color: #1a1000; border: none; font-weight: 700; }
QPushButton#refreshButton:hover { background-color: #fbb53a; }
QPushButton#openFolderButton { background-color: #3b82f6; color: #ffffff; border: none; font-weight: 700; }
QPushButton#openFolderButton:hover { background-color: #5b9aff; }
QListWidget { background-color: #0b0b0b; border: 1px solid #2a2a2a; border-radius: 12px; padding: 6px; outline: none; }
QListWidget::item { padding: 8px 10px; border-radius: 8px; }
QListWidget::item:selected { background-color: #2a2a2a; color: #ffffff; }
QListWidget::item:hover { background-color: #181818; }
QPushButton#modSearchButton { background-color: #3b82f6; color: #ffffff; border: none; font-weight: 700; }
QPushButton#modSearchButton:hover { background-color: #5b9aff; }
QPushButton#modInstallButton { background-color: #22d65f; color: #03150a; border: none; font-weight: 800; }
QPushButton#modInstallButton:hover { background-color: #3ee878; }
QPushButton#modInstallButton:disabled, QPushButton#modSearchButton:disabled { background-color: #262626; color: #6a6a6a; }
QPushButton#modRemoveButton { background-color: #ef4444; color: #ffffff; border: none; font-weight: 700; }
QPushButton#modRemoveButton:hover { background-color: #f87171; }
QPushButton#packSearchButton { background-color: #3b82f6; color: #ffffff; border: none; font-weight: 700; }
QPushButton#packSearchButton:hover { background-color: #5b9aff; }
QPushButton#packInstallButton { background-color: #22d65f; color: #03150a; border: none; font-weight: 800; }
QPushButton#packInstallButton:hover { background-color: #3ee878; }
QPushButton#packInstallButton:disabled { background-color: #262626; color: #6a6a6a; }
QPushButton#packRemoveButton { background-color: #ef4444; color: #ffffff; border: none; font-weight: 700; }
QPushButton#packRemoveButton:hover { background-color: #f87171; }
QProgressBar { background-color: rgba(255, 255, 255, 30); border: none; border-radius: 4px; max-height: 8px; color: transparent; }
QProgressBar::chunk { background-color: #22d65f; border-radius: 4px; }
QPlainTextEdit { background-color: #0b0b0b; border: 1px solid #2a2a2a; border-radius: 12px; padding: 8px; font-family: Menlo; font-size: 12px; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 18px; height: 18px; border-radius: 5px; border: 1px solid #555555; background: #101010; }
QCheckBox::indicator:checked { background-color: #ffffff; border-color: #ffffff; }
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #3a3a3a; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
</string></property>
